# Duo mode across devices needs a Supabase project (free tier is enough).
# Copy this file to .env.local, fill in the values from
# Supabase → Project Settings → API, and add the same two variables in Vercel.
# Without them, Duo still works between tabs of the same browser (test mode).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
