# Duo mode talks to the relay in server/relay.mjs.
# A production build served by the Hetzner setup (deploy/) finds it by itself at
# wss://<same host>/relay, so nothing needs to be set there.
# Set this only for local testing against a relay, or if the game is hosted
# somewhere else than the relay (e.g. on Vercel):
# VITE_RELAY_URL=ws://localhost:8787
